PORT=3000

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Frontend URL (CORS)
CORS_ORIGIN=http://localhost:5173

# SMTP — Email de l'application (pour envoyer les codes OTP)
# Gmail   : SMTP_HOST=smtp.gmail.com        SMTP_PORT=587
# Outlook : SMTP_HOST=smtp.office365.com    SMTP_PORT=587
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=email_de_lapplication@outlook.com
SMTP_PASS=mot_de_passe
