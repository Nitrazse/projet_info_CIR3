# Port du serveur Express
PORT=3000

# URL du projet Supabase (Settings > API > Project URL)
SUPABASE_URL=

# Clé publique (anon) — sans permissions élevées
SUPABASE_ANON_KEY=

# Clé service_role — NE JAMAIS exposer côté client, uniquement côté serveur
SUPABASE_SERVICE_ROLE_KEY=

# Origine autorisée par CORS (URL du front React en dev)
CORS_ORIGIN=http://localhost:5173
